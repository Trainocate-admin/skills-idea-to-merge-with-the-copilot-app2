---
// Bookmarks component.
//
// The markup below renders during the static build. The dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// runs ONLY in the client-side <script> boundary at the bottom of this
// file. Astro runs that script in the browser, never during the build, so
// browser-only APIs (localStorage, etc.) are safe there. The pure logic it
// relies on lives in src/lib/bookmarks.js so it can be unit tested without a
// browser.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p id="url-error" class="error" role="alert" hidden></p>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  // CLIENT-SIDE BOUNDARY — runs in the browser only.
  //
  // Astro only executes this <script> in the browser (never during the
  // static build), so localStorage and other browser APIs are safe here.
  // The pure, testable logic (URL normalisation, slug generation, storage
  // parsing/formatting) lives in src/lib/bookmarks.js and is imported below —
  // that module never touches the DOM or localStorage itself.
  import {
    STORAGE_KEY,
    normalizeUrl,
    generateSlug,
    parseStoredBookmarks,
    serializeBookmarks,
  } from '../lib/bookmarks.js';

  const form = document.getElementById('add-bookmark');
  const urlInput = document.getElementById('url');
  const urlError = document.getElementById('url-error');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAllButton = document.getElementById('clear-all');
  const list = document.getElementById('bookmark-list');

  /** @type {Array<{ url: string, slug: string }>} */
  let bookmarks = [];

  function readStorage() {
    // localStorage.getItem itself can throw (e.g. disabled storage in some
    // browser privacy modes) — treat every failure as "no bookmarks yet"
    // rather than letting it bubble up.
    try {
      return parseStoredBookmarks(localStorage.getItem(STORAGE_KEY));
    } catch {
      return [];
    }
  }

  function writeStorage() {
    try {
      localStorage.setItem(STORAGE_KEY, serializeBookmarks(bookmarks));
    } catch {
      // Ignore storage failures (quota exceeded, disabled, etc.) — the
      // in-memory list still renders for this page view.
    }
  }

  function showError(message) {
    if (!urlError) return;
    urlError.textContent = message;
    urlError.hidden = false;
  }

  function clearError() {
    if (!urlError) return;
    urlError.hidden = true;
    urlError.textContent = '';
  }

  function uniqueSlug() {
    let slug = generateSlug();
    const existing = new Set(bookmarks.map((bookmark) => bookmark.slug));
    while (existing.has(slug)) {
      slug = generateSlug();
    }
    return slug;
  }

  function render() {
    if (!list) return;
    list.textContent = '';

    const hasBookmarks = bookmarks.length > 0;
    if (emptyState) emptyState.hidden = hasBookmarks;
    if (listHeader) listHeader.hidden = !hasBookmarks;

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'sep';
      separator.textContent = ' :: ';
      separator.setAttribute('aria-hidden', 'true');

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copyButton = document.createElement('button');
      copyButton.type = 'button';
      copyButton.className = 'copy';
      copyButton.textContent = 'Copy';
      copyButton.addEventListener('click', () => {
        copySlug(bookmark.slug, copyButton);
      });

      item.append(link, separator, slug, copyButton);
      list.append(item);
    }
  }

  function copySlug(slug, button) {
    const fallback = () => {
      const textarea = document.createElement('textarea');
      textarea.value = slug;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.append(textarea);
      textarea.select();
      try {
        document.execCommand('copy');
      } catch {
        // Ignore — copying is a nice-to-have, not critical.
      }
      textarea.remove();
    };

    const flashCopied = () => {
      const original = button.textContent;
      button.textContent = 'Copied!';
      setTimeout(() => {
        button.textContent = original;
      }, 1500);
    };

    if (navigator.clipboard?.writeText) {
      navigator.clipboard.writeText(slug).then(flashCopied, () => {
        fallback();
        flashCopied();
      });
    } else {
      fallback();
      flashCopied();
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault(); // keep this — stops the page from reloading
    clearError();

    const rawValue = urlInput instanceof HTMLInputElement ? urlInput.value : '';

    let normalized;
    try {
      normalized = normalizeUrl(rawValue);
    } catch {
      showError('Please enter a valid URL, e.g. example.com or https://example.com.');
      return;
    }

    bookmarks = [...bookmarks, { url: normalized, slug: uniqueSlug() }];
    writeStorage();
    render();

    form.reset();
    urlInput?.focus();
  });

  clearAllButton?.addEventListener('click', () => {
    if (bookmarks.length === 0) return;
    const confirmed = window.confirm('Remove all saved bookmarks? This cannot be undone.');
    if (!confirmed) return;

    bookmarks = [];
    writeStorage();
    render();
  });

  // Load any previously saved bookmarks and render them so the list
  // survives a reload.
  bookmarks = readStorage();
  render();
</script>
